rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(churchId) {
      return get(/databases/$(database)/documents/churches/$(churchId)/users/$(request.auth.uid));
    }

    function belongsToChurch(churchId) {
      return signedIn() && userDoc(churchId).data.churchId == churchId;
    }

    function role(churchId) {
      return userDoc(churchId).data.role;
    }

    function isAdmin(churchId) {
      return belongsToChurch(churchId) && role(churchId) == 'Administrator';
    }

    function canWriteFinancial(churchId) {
      return belongsToChurch(churchId) && role(churchId) in ['Administrator', 'Treasurer', 'Assistant Treasurer'];
    }

    function isAuditor(churchId) {
      return belongsToChurch(churchId) && role(churchId) == 'Auditor';
    }

    function unlocked() {
      return !('auditStatus' in resource.data) || resource.data.auditStatus != 'Locked';
    }

    function approvedAccount() {
      return signedIn() && request.auth.token.email in [
        'admin@bethelsda.local',
        'treasurer@bethelsda.local',
        'elder@bethelsda.local',
        'guest@bethelsda.local'
      ];
    }

    function validSelfRole(churchId, userId) {
      return request.auth.uid == userId
        && request.resource.data.churchId == churchId
        && request.resource.data.email == request.auth.token.email
        && (
          (request.auth.token.email == 'admin@bethelsda.local' && request.resource.data.role == 'Administrator')
          || (request.auth.token.email == 'treasurer@bethelsda.local' && request.resource.data.role == 'Treasurer')
          || (request.auth.token.email == 'elder@bethelsda.local' && request.resource.data.role == 'Pastor or Church Elder')
          || (request.auth.token.email == 'guest@bethelsda.local' && request.resource.data.role == 'Pastor or Church Elder')
        );
    }

    match /churches/{churchId} {
      allow read: if belongsToChurch(churchId);
      allow write: if isAdmin(churchId);

      match /users/{userId} {
        allow read: if belongsToChurch(churchId);
        allow create, update: if approvedAccount() && validSelfRole(churchId, userId);
        allow write: if isAdmin(churchId);
      }

      match /settings/{docId} {
        allow read: if belongsToChurch(churchId);
        allow write: if isAdmin(churchId);
      }

      match /offeringCategories/{docId} {
        allow read: if belongsToChurch(churchId);
        allow write: if isAdmin(churchId);
      }

      match /appState/{docId} {
        allow read: if belongsToChurch(churchId);
        allow write: if canWriteFinancial(churchId);
      }

      match /financialYears/{year}/months/{month}/{collection}/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create: if canWriteFinancial(churchId);
        allow update: if (canWriteFinancial(churchId) && unlocked()) || isAuditor(churchId);
        allow delete: if false;
      }

      match /financialYears/{year}/quarters/{quarter}/{collection}/{docId} {
        allow read: if belongsToChurch(churchId);
        allow write: if canWriteFinancial(churchId) || isAuditor(churchId);
        allow delete: if false;
      }

      match /auditLogs/{docId} {
        allow read: if belongsToChurch(churchId);
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }
  }
}
